{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lepidy",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      },
      {
        "name": "WORKSPACE",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Accounts", "Workspace"]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "lepidy-control",
      "database_id": "87fa475a-4ac5-4769-ad1d-3ad0c504110e",
      "migrations_dir": "migrations/control"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "525dfac4372f474b9086faf4eab35e14"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lepidy-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "lepidy-events"
      }
    ]
  },
  "routes": [
    {
      "pattern": "lepidy.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
