// The workspace Durable Object, hosted as its own local worker.
//
// `getPlatformProxy` (which is what gives `next dev` its bindings) cannot run a
// Durable Object itself; the documented arrangement is to define the object in a
// separate Worker and reference it by `script_name`. This is that Worker, and it
// exists for local development and the browser suite only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lepidy-workspace-dev",
  "main": "dev-worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      },
      {
        "name": "WORKSPACE",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Accounts", "Workspace"]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "lepidy-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/control"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "lepidy-events"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "development"
  }
}
