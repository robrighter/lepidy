{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window chrome and the seven native commands, for the workspace origin only.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-runner-status",
    "allow-runner-stop",
    "allow-runner-start",
    "allow-local-verify",
    "allow-platform-name",
    "allow-notify",
    "allow-set-badge"
  ]
}
