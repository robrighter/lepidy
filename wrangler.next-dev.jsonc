{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lepidy-next-dev",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts",
        "script_name": "lepidy-workspace-dev"
      },
      {
        "name": "WORKSPACE",
        "class_name": "Workspace",
        // Hosted by wrangler.do-dev.jsonc: the dev proxy cannot run an object
        // itself, so it reaches this one through the local dev registry.
        "script_name": "lepidy-workspace-dev"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "lepidy-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/control"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lepidy-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "lepidy-events"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "development"
  }
}
