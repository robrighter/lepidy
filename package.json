{
  "name": "lepidy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:workers",
    "test:workers": "vitest run",
    "test:watch": "vitest",
    "test:browser": "cargo build --manifest-path src-tauri/Cargo.toml -p lepidy-cli -p lepidy-runner --bins && opennextjs-cloudflare build && playwright test",
    "test:browser:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "db:migrate:local": "wrangler d1 migrations apply CONTROL_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply CONTROL_DB --remote",
    "verify:local": "node scripts/verify-local.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@opennextjs/cloudflare": "^1.20.6",
    "@simplewebauthn/server": "^14.0.0",
    "@tauri-apps/api": "^2.8.0",
    "argon2id": "^1.0.0",
    "lucide-react": "^0.542.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0",
    "ws": "^8.21.3"
  }
}
