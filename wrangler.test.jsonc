{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lepidy-test",
  "main": "tests/fixtures/workspace-worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      },
      {
        "name": "WORKSPACE",
        "class_name": "Workspace"
      },
      {
        "name": "MIGRATION_FIXTURE",
        "class_name": "MigrationFixture"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Accounts", "Workspace", "MigrationFixture"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "lepidy-events-test"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "lepidy-control-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/control"
    }
  ]
}
